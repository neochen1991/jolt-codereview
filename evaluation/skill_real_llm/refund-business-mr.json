        "+package com.acme.refund.api;",
        "+",
        "+import com.acme.refund.service.RefundService;",
        "+import org.springframework.web.bind.annotation.PostMapping;",
        "+import org.springframework.web.bind.annotation.RequestBody;",
        "+import org.springframework.web.bind.annotation.RestController;",
        "+import java.util.List;",
        "+import java.util.Map;",
        "+",
        "+@RestController",
        "+public class RefundAdminController {",
        "+  private final RefundService refundService;",
        "+  public RefundAdminController(RefundService refundService) { this.refundService = refundService; }",
        "+",
        "+  @PostMapping(\"/admin/refunds/batch-approve\")",
        "+  public Map<String, Object> approve(@RequestBody Map<String, Object> payload) {",
        "+    List<String> refundIds = (List<String>) payload.get(\"refundIds\");",
        "+    String operator = String.valueOf(payload.get(\"operator\"));",
        "+    String reason = String.valueOf(payload.get(\"reason\"));",
        "+    refundService.approveBatch(refundIds, operator, reason);",
        "+    return Map.of(\"ok\", true);",
        "+  }",
        "+}"
      ]
    },
