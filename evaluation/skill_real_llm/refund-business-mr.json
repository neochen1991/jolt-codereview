      "filename": "src/main/java/com/acme/refund/infra/RefundCache.java",
      "patch_lines": [
        "@@ -0,0 +1,64 @@",
        "+package com.acme.refund.infra;",
        "+",
        "+import java.util.Set;",
        "+import org.springframework.data.redis.core.RedisTemplate;",
        "+",
        "+public class RefundCache {",
        "+  private final RedisTemplate<String, Object> redisTemplate;",
        "+  public RefundCache(RedisTemplate<String, Object> redisTemplate) { this.redisTemplate = redisTemplate; }",
        "+",
        "+  public void cacheRefundDetail(String refundId, Object value) {",
        "+    redisTemplate.opsForValue().set(\"refund:detail:\" + refundId, value);",
        "+  }",
        "+",
        "+  public void clearRefundCache() {",
        "+    Set<String> keys = redisTemplate.keys(\"refund:*\");",
        "+    redisTemplate.delete(keys);",
        "+  }",
        "+}"
      ]
    },
    {
