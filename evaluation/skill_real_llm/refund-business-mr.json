        "+package com.acme.refund.infra;",
        "+",
        "+import org.springframework.data.redis.core.RedisTemplate;",
        "+",
        "+public class SystemConfigCache {",
        "+  private final RedisTemplate<String, Object> redisTemplate;",
        "+  public SystemConfigCache(RedisTemplate<String, Object> redisTemplate) { this.redisTemplate = redisTemplate; }",
        "+",
        "+  public void cachePermanentConfig(Object config) {",
        "+    // permanent system configuration key, not business cache",
        "+    redisTemplate.opsForValue().set(\"system:refund:config\", config);",
        "+  }",
        "+}"
