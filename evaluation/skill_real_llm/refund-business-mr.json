      "patch_lines": [
        "@@ -0,0 +1,130 @@",
        "+package com.acme.refund.service;",
        "+",
        "+import java.util.List;",
        "+import org.slf4j.Logger;",
        "+import org.slf4j.LoggerFactory;",
        "+",
        "+public class RefundService {",
        "+  private static final Logger log = LoggerFactory.getLogger(RefundService.class);",
        "+  private final PaymentGateway paymentGateway;",
        "+  private final OrderService orderService;",
        "+  private final StockService stockService;",
        "+  private final CouponService couponService;",
        "+  private final RefundMessageProducer producer;",
        "+",
        "+  public RefundService(PaymentGateway paymentGateway, OrderService orderService, StockService stockService,",
        "+      CouponService couponService, RefundMessageProducer producer) {",
        "+    this.paymentGateway = paymentGateway;",
        "+    this.orderService = orderService;",
        "+    this.stockService = stockService;",
        "+    this.couponService = couponService;",
        "+    this.producer = producer;",
        "+  }",
        "+",
        "+  public void approveBatch(List<String> refundIds, String operator, String reason) {",
        "+    for (String refundId : refundIds) {",
        "+      try {",
        "+        RefundOrder refund = orderService.loadRefund(refundId);",
        "+        paymentGateway.refund(refund.getPaymentNo(), refund.getAmount());",
        "+        orderService.markRefunded(refund.getOrderId());",
        "+        stockService.releaseStock(refund.getOrderId());",
        "+        couponService.returnCoupon(refund.getCouponId());",
        "+        producer.sendRefundApproved(refundId);",
        "+      } catch (Exception e) {",
        "+        log.warn(\"approve refund failed, refundId={}, operator={}\", refundId, operator, e);",
        "+        continue;",
        "+      }",
        "+    }",
        "+  }",
        "+}"
      ]
    },
