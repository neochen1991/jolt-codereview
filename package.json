{
  "name": "jolt-codereview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:common": "npm --prefix common-backend run dev",
    "dev:mr": "npm --prefix mr-backend run dev",
    "dev:web": "npm --prefix frontend run dev",
    "worker": "npm --prefix mr-backend run worker",
    "worker:once": "npm --prefix mr-backend run worker:once",
    "dev": "node scripts/start-all.mjs",
    "install:modules": "npm --prefix common-backend install && npm --prefix mr-backend install && npm --prefix frontend install",
    "sync:modules": "node scripts/export-three-repos.mjs --force",
    "export:repos": "node scripts/export-three-repos.mjs --force --out=/private/tmp/jolt-three-service-export",
    "build": "npm --prefix common-backend run build && npm --prefix mr-backend run build && npm --prefix frontend run build",
    "verify": "npm run build && npm run verify:frontend-api-routing && npm run verify:skill-upload-paths && npm run verify:bound-rule-skill-full-read && npm run verify:postgres-only-runtime",
    "verify:split-full-regression": "node scripts/verify-split-full-regression.mjs",
    "verify:frontend-api-routing": "node scripts/verify-frontend-api-routing.mjs",
    "verify:skill-upload-paths": "node scripts/verify-skill-upload-paths.mjs",
    "verify:bound-rule-skill-full-read": "node scripts/verify-bound-rule-skill-full-read.mjs",
    "verify:postgres-only-runtime": "node scripts/verify-postgres-only-runtime.mjs"
  },
  "dependencies": {
    "@types/pg": "^8.20.0",
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "^0.555.0",
    "pg": "^8.21.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "vite": "^7.2.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  }
}
